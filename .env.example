IMAGE_TABLE_DATA_DIR=data
IMAGE_TABLE_BACKEND_HOST=127.0.0.1
IMAGE_TABLE_BACKEND_PORT=8000
IMAGE_TABLE_FRONTEND_HOST=127.0.0.1
IMAGE_TABLE_FRONTEND_PORT=5173
IMAGE_TABLE_WORKER_CONCURRENCY=1
IMAGE_TABLE_CRAWL_CONCURRENCY=1
IMAGE_TABLE_OCR_CONCURRENCY=1
IMAGE_TABLE_OCR_DEVICE=cuda
IMAGE_TABLE_OCR_MODEL_ROOT_DIR=./models
IMAGE_TABLE_OCR_CUDA_DEVICE_ID=0
IMAGE_TABLE_LEASE_SECONDS=900

# Oracle 直写配置（不填写时，预校验会阻断数据库导入）
# IMAGE_TABLE_ORACLE_DATABASE_URL=oracle+oracledb://user:password@host:1521/?service_name=SERVICE
# 二选一：固定业务用户 ID，或通过 SQL 按 Oracle SESSION_USER 查询业务用户 ID
# IMAGE_TABLE_ORACLE_CREATOR_ID=12345
# IMAGE_TABLE_ORACLE_CREATOR_LOOKUP_SQL=SELECT USER_ID FROM APP_USER WHERE LOGIN_NAME = :session_user
# IMAGE_TABLE_ORACLE_APPLICATION_VERSION=V260123
# IMAGE_TABLE_ORACLE_IMPORT_TIMEOUT_SECONDS=30
